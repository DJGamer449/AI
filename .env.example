# Required: password users enter in the browser to unlock the app
APP_PASSWORD=change-me-to-a-long-random-password

# Required: Orbit Provider API key. Never expose this in frontend code.
ORBIT_API_KEY=sk-orbit-your-key-here

# Recommended in production: long random secret used to sign auth cookies
APP_SECRET=change-me-to-a-32-byte-random-secret

# Optional
ORBIT_BASE_URL=https://api.orbit-provider.com/api/provider/agy/v1
SESSION_TTL_SECONDS=86400
CORS_ORIGINS=
COOKIE_SECURE=false
